---
import PageBg from '../components/PageBg.astro';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const c = site.contact as any;
const hasKey = !!(c.formKey && c.formKey.trim());
---
<Base title="Contact" description={c.lede} current="contact">
  {hasKey && <script slot="head" is:inline src="https://web3forms.com/client/script.js" async defer></script>}
  <header class="page-head" slot="top">
    <PageBg />
    <div class="intro">
      <p class="eyebrow fade" data-delay=".15">{c.eyebrow}</p>
      <div class="rule" aria-hidden="true"></div>
      <h1><span class="ln"><span class="rise">{c.title}</span></span> <span class="ln"><span class="rise dim">{c.titleDim}</span></span></h1>
      <div class="rule" aria-hidden="true"></div>
      <p class="lede fade" data-delay=".9">{c.lede}</p>
    </div>
  </header>

  <main class="contact">
    <section class="ct-grid">
      <aside class="ct-info reveal">
        <p class="ab-h"><span>01</span>Say hello</p>
        <a class="ct-email" href={`mailto:${c.email}`}>{c.email}</a>
        {c.whatsapp && (
          <a class="ct-wa" href={`https://wa.me/${c.whatsapp}?text=${encodeURIComponent("Hi Tushar, I found your portfolio and I'd like to talk about a project.")}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
            <span><i>WhatsApp</i><b>{c.whatsappLabel || c.whatsapp}</b></span>
          </a>
        )}
        <dl class="ct-meta">
          <div><dt>Based in</dt><dd>{c.location}</dd></div>
          <div><dt>Local time</dt><dd id="clock">Sydney</dd></div>
          {c.available && <div><dt>Status</dt><dd><i class="dot"></i>Available for projects</dd></div>}
        </dl>
      </aside>

      <form class="ct-form reveal" id="contact-form" action="https://api.web3forms.com/submit" method="POST" data-key={hasKey ? 'yes' : ''} data-email={c.email} novalidate>
        <p class="ab-h"><span>02</span>Tell me about your project</p>
        <input type="hidden" name="access_key" value={c.formKey || ''}>
        <input type="hidden" name="subject" value="New enquiry from collabwithtushar">
        <input type="hidden" name="from_name" value="Portfolio contact form">
        <!-- spam traps: real people never see or fill these -->
        <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="_started" value="">
        <div class="field half"><label for="f-name">Name</label><input id="f-name" name="name" type="text" autocomplete="name" required maxlength="80"></div>
        <div class="field half"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required maxlength="120"></div>
        <fieldset class="field">
          <legend>What do you need?</legend>
          <div class="chips">{c.projectTypes.map((t: string, i: number) => <label class="chip"><input type="radio" name="project_type" value={t} checked={i === 0}><span>{t}</span></label>)}</div>
        </fieldset>
        <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" name="message" rows="6" required minlength="10" maxlength="3000"></textarea></div>
        {hasKey && <div class="h-captcha" data-captcha="true"></div>}
        <div class="ct-actions">
          <button class="btn btn-dark" type="submit">Send message <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M0 6h16M11 1l5 5-5 5"/></svg></button>
          <p class="status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>
  </main>
</Base>
